# ---------------------------------------------------------------------------
# Never commit the heavy stuff. This folder holds ~57 GB of models and runtime
# next to a few hundred KB of source; without this file `git add .` would try
# to push all of it.
# ---------------------------------------------------------------------------

# Model weights and Ollama's blob store (tens of GB)
models/
model/
*.gguf
*.bin
*.safetensors

# The Ollama runtime itself — users install their own
ollama/
ollama_old_*/
ollama_UNINSTALLED_*/
downloads/

# Build output — ship these as GitHub Release assets, not repo files
build/
dist/
*.exe
*.zip

# Per-user data created at runtime
CriGent-data/
chats/
skills.json
prompts.json
settings.json
location.json
usage.json
crashes.json

# Logs and scratch
*.log
ollama_server.log
gguf_patch.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Modelfiles point at .gguf files by absolute path on the machine that made
# them — personal to each install, and regenerated by "Add model...".
Modelfile
Modelfile.*

# Superseded by CriGent: the original tkinter UI, the standalone GPU monitor
# and the pre-rebrand CLI shims. Kept locally, not part of the published project.
qwenop_gui_tk.py
qwenop_gui.py
gpu_monitor.py
launch_gpu_monitor.bat
launch_qwenop.bat
scripts/
